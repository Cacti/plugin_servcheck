msgid "Help"
msgstr "Hulp"

#: includes/arrays.php
msgid "Credential Name"
msgstr "Aanmeldbewysnaam"

#: includes/arrays.php
msgid "The name that is displayed for this Credential."
msgstr "Die naam wat vir hierdie Geloofsbrief vertoon word."

#: includes/arrays.php
msgid "Credential type"
msgstr "Aanmeldbewystipe"

#: includes/arrays.php
msgid "Select correct Credential type."
msgstr "Kies die korrekte Geloofsbrieftipe."

#: includes/arrays.php
msgid "Options"
msgstr "Opsies"

#: includes/arrays.php
msgid "Set according to your REST API server"
msgstr "Stel volgens jou REST API-bediener"

