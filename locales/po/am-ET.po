msgid "Cacti attempts to run each test multiple times. The first successful attempt ends the testing and records the success. If none of the attempts are successful, the test is terminated and a failure is recorded. High number causes log test duration."
msgstr "Cacti እያንዳንዱን ሙከራ ብዙ ጊዜ ለማስኬድ ይሞክራል። የመጀመሪያው የተሳካ ሙከራ ሙከራውን ያበቃል እና ስኬቱን ይመዘግባል። ከሙከራዎቹ ውስጥ አንዱም ካልተሳካ፣ ሙከራው ይቋረጣል እና ውድቀት ይመዘገባል። ከፍተኛ ቁጥር የሙከራ ቆይታን ያረዝማል።"

#: includes/arrays.php
msgid "Enable test"
msgstr "ሙከራ አንቃ"

#: includes/arrays.php
msgid "Uncheck this box to disable this test from being checked."
msgstr "ይህ ሙከራ እንዳይረጋገጥ ለማሰናከል የዚህን ሳጥን ምልክት ያንሱ።"

#: includes/arrays.php
msgid "Enable run script for this test"
msgstr "ለዚህ ሙከራ ስክሪፕት ማስኬድን አንቃ"

#: includes/arrays.php
msgid "If the global Command Execution function is enabled, you can set here whether the script should be run for this test or not."
msgstr "ዓለም አቀፋዊ የትዕዛዝ ማስፈጸሚያ ተግባር ከነቃ፣ ስክሪፕቱ ለዚህ ሙከራ መሄድ እንዳለበት ወይም እንደሌለበት እዚህ ማቀናበር ይችላሉ።"

#: includes/arrays.php
msgid "Poller"
msgstr "ፖለር"

#: includes/arrays.php
msgid "Poller on which the test will run"
msgstr "ሙከራው የሚካሄድበት ፖለር"

#: includes/arrays.php
msgid "Type of service"
msgstr "የአገልግሎት ዓይነት"

#: includes/arrays.php
msgid "What type of service?"
msgstr "ምን ዓይነት አገልግሎት?"

#: includes/arrays.php
msgid "IP Address or DNS name of server"
msgstr "የአገልጋዩ IP አድራሻ ወይም DNS ስም"

#: includes/arrays.php
msgid "You can specify another port (example.com:5000) otherwise default will be used. For IPv6 numeric address use [ip:ad:dr:es:fo:rma:at]. For DOH (DNS over HTTPS) use here name of server (example 10.10.10.10, cloudflare-dns.com, ..)"
msgstr "ሌላ ወደብ (example.com:5000) መግለጽ ይችላሉ፣ ያለበለዚያ ነባሪው ጥቅም ላይ ይውላል። ለIPv6 ቁጥራዊ አድራሻ [ip:ad:dr:es:fo:rma:at] ይጠቀሙ። ለDOH (DNS over HTTPS) እዚህ የአገልጋዩን ስም ይጠቀሙ (ለምሳሌ 10.10.10.10, cloudflare-dns.com, ..)"

#: includes/arrays.php
msgid "Resolve DNS to Address"
msgstr "DNS ወደ አድራሻ ፍታ"

#: includes/arrays.php
msgid "Enter an IP Address to force DNS name to resolve to. Leaving blank will use DNS Resolution instead."
msgstr "የDNS ስም እንዲፈታበት የሚያስገድድ IP አድራሻ ያስገቡ። ባዶ መተው በምትኩ DNS አፈታትን ይጠቀማል።"

#: includes/arrays.php
msgid "Service settings"
msgstr "የአገልግሎት ቅንብሮች"

#: includes/arrays.php
msgid "Select correct credential"
msgstr "ትክክለኛውን ማረጋገጫ ይምረጡ"

#: includes/arrays.php
msgid "SNMP OID"
msgstr "SNMP OID"

#: includes/arrays.php
msgid "Insert SNMP OID"
msgstr "SNMP OID ያስገቡ"

#: includes/arrays.php
msgid "SSH command"
msgstr "የSSH ትዕዛዝ"

#: includes/arrays.php
msgid "Insert SSH command with full path, result of command will be returned"
msgstr "የSSH ትዕዛዝን ከሙሉ መንገዱ ጋር ያስገቡ፤ የትዕዛዙ ውጤት ይመለሳል"

#: includes/arrays.php
msgid "Your own CA and intermediate certs"
msgstr "የራስዎ CA እና መካከለኛ የምስክር ወረቀቶች"

#: includes/arrays.php
msgid "LDAP Search"
msgstr "የLDAP ፍለጋ"

#: includes/arrays.php
msgid "LDAP search filter, it could be ,OU=anygroup,DC=example,DC=com"
msgstr "የLDAP ፍለጋ ማጣሪያ፣ ለምሳሌ ,OU=anygroup,DC=example,DC=com ሊሆን ይችላል"

#: includes/arrays.php
msgid "DNS Name for Query"
msgstr "ለጥያቄ የDNS ስም"

#: includes/arrays.php
msgid "DNS name for querying. For DOH (DNS over HTTPS) use /resolve?name=example.com or /dns-query?name=example.com&type=A. For plaintext DNS A and AAAA records will be returned"
msgstr "ለመጠየቅ የDNS ስም። ለDOH (DNS በHTTPS ላይ) /resolve?name=example.com ወይም /dns-query?name=example.com&type=A ይጠቀሙ። ለግልጽ ጽሑፍ DNS፣ የA እና AAAA መዝገቦች ይመለሳሉ"

#: includes/arrays.php
msgid "Path Part of URL"
msgstr "የURL መንገድ ክፍል"

#: includes/arrays.php
msgid "For web service insert at least \"/\" or something like \"/any/path/\"."
msgstr "ለድር አገልግሎት ቢያንስ \"/\" ወይም እንደ \"/any/path/\" ያለ ነገር ያስገቡ።"

#: includes/arrays.php
msgid "Requires Authentication"
msgstr "ማረጋገጫ ያስፈልገዋል"

#: includes/arrays.php
msgid "Check this box if the site will normally return a 401 Error as it requires a username and password."
msgstr "ጣቢያው የተጠቃሚ ስም እና የይለፍ ቃል ስለሚጠይቅ በተለምዶ 401 ስህተት የሚመልስ ከሆነ ይህን ሳጥን ይምረጡ።"

#: includes/arrays.php
msgid "Proxy Server"
msgstr "ተኪ አገልጋይ"

#: includes/arrays.php
