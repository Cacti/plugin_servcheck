#: includes/arrays.php
msgid "Use this Notification List for those to be notified when this service goes down."
msgstr "ይህ አገልግሎት ሲቆም ማሳወቂያ ለሚደርሳቸው ሰዎች ይህን የማሳወቂያ ዝርዝር ይጠቀሙ።"

#: includes/arrays.php
msgid "Notify Accounts"
msgstr "መለያዎችን አሳውቅ"

#: includes/arrays.php
msgid "This is a listing of accounts that will be notified when this service goes down."
msgstr "ይህ አገልግሎት ሲቋረጥ ማሳወቂያ የሚደርሳቸው መለያዎች ዝርዝር ነው።"

#: includes/arrays.php
msgid "Extra Alert Emails"
msgstr "ተጨማሪ የማንቂያ ኢሜይሎች"

#: includes/arrays.php
msgid "You may specify here extra Emails to receive alerts for this test (comma separated)"
msgstr "ለዚህ ሙከራ ማንቂያዎችን የሚቀበሉ ተጨማሪ ኢሜይሎችን እዚህ መግለጽ ይችላሉ (በኮማ የተለዩ)"

#: includes/arrays.php
msgid "Notes"
msgstr "ማስታወሻዎች"

#: includes/arrays.php
msgid "Notes sent in email"
msgstr "በኢሜይል የተላኩ ማስታወሻዎች"

#: includes/arrays.php
msgid "External ID"
msgstr "ውጫዊ መለያ (ID)"

#: includes/arrays.php
msgid "Enter an External ID for this test."
msgstr "ለዚህ ሙከራ ውጫዊ መታወቂያ (External ID) ያስገቡ።"

#: includes/arrays.php
msgid "Help"
msgstr "እገዛ"

