msgstr "%d procesa"

#: setup.php
msgid "Certificate expiry date advanced notification email"
msgstr "E-mail za rano obavještenje o datumu isteka certifikata"

#: setup.php
msgid "If SSL/TLS service certificate expiration is enabled, set how many days advanced notice period before certificate expiry date the system will send notification"
msgstr "Ako je omogućeno praćenje isteka SSL/TLS certifikata servisa, podesite koliko dana unaprijed prije datuma isteka certifikata će sistem slati obavještenje"

