msgid "Help"
msgstr "Pomoć"

#: includes/arrays.php
msgid "Credential Name"
msgstr "Naziv akreditiva"

#: includes/arrays.php
msgid "The name that is displayed for this Credential."
msgstr "Naziv koji se prikazuje za ovaj akreditiv."

#: includes/arrays.php
msgid "Credential type"
msgstr "Tip akreditiva"

#: includes/arrays.php
msgid "Select correct Credential type."
msgstr "Odaberite ispravan tip akreditiva."

#: includes/arrays.php
msgid "Options"
msgstr "Opcije"

#: includes/arrays.php
msgid "Set according to your REST API server"
msgstr "Postavite prema vašem REST API serveru"

#: includes/arrays.php
msgid "Username"
msgstr "Korisničko ime"

#: includes/arrays.php
msgid "Password"
msgstr "Lozinka"

#: includes/arrays.php
msgid "For anonymous FTP insert email address"
msgstr "Za anonimni FTP unesite email adresu"

#: includes/arrays.php
msgid "Login URL"
msgstr "URL za prijavu"

#: includes/arrays.php
msgid "URL which is used to log in or get the token."
msgstr "URL koji se koristi za prijavu ili dobijanje tokena."

#: includes/arrays.php
msgid "Data URL"
msgstr "URL za podatke"

#: includes/arrays.php
msgid "URL to retrieve data. Insert with http:// or https://"
msgstr "URL za preuzimanje podataka. Unesite sa http:// ili https://"

#: includes/arrays.php
msgid "SNMP v1 or v2 community"
msgstr "SNMP v1 ili v2 zajednica"

#: includes/arrays.php
msgid "SNMP community string for SNMP v1 or v2(c)"
msgstr "SNMP string zajednice za SNMP v1 ili v2(c)"

#: includes/arrays.php
msgid "SNMP Security Level"
msgstr "SNMP nivo sigurnosti"

#: includes/arrays.php
msgid "SNMP v3 Security Level to use when querying the device."
msgstr "SNMP v3 nivo sigurnosti koji se koristi prilikom upita prema uređaju."

#: includes/arrays.php
msgid "SNMP Auth Protocol (v3)"
msgstr "SNMP protokol autentifikacije (v3)"

#: includes/arrays.php
msgid "Choose the SNMPv3 Authorization Protocol."
msgstr "Odaberite SNMPv3 protokol autorizacije."

#: includes/arrays.php
msgid "SNMP Username (v3)"
msgstr "SNMP korisničko ime (v3)"

#: includes/arrays.php
msgid "SNMP v3 username for this device."
msgstr "SNMP v3 korisničko ime za ovaj uređaj."

#: includes/arrays.php
msgid "SNMP Password (v3)"
msgstr "SNMP lozinka (v3)"

#: includes/arrays.php
msgid "SNMP v3 password for this device."
msgstr "SNMP v3 lozinka za ovaj uređaj."

#: includes/arrays.php
msgid "SNMP Privacy Protocol (v3)"
msgstr "SNMP protokol privatnosti (v3)"

#: includes/arrays.php
msgid "Choose the SNMPv3 Privacy Protocol."
msgstr "Odaberite SNMPv3 protokol privatnosti."

#: includes/arrays.php
msgid "SNMP Privacy Passphrase (v3)"
msgstr "SNMP pristupna fraza privatnosti (v3)"

#: includes/arrays.php
msgid "Choose the SNMPv3 Privacy Passphrase."
msgstr "Odaberite SNMPv3 pristupnu frazu privatnosti."

#: includes/arrays.php
msgid "SNMP Context (v3)"
msgstr "SNMP kontekst (v3)"

#: includes/arrays.php
msgid "Enter the SNMP Context to use for this device."
msgstr "Unesite SNMP kontekst koji se koristi za ovaj uređaj."

#: includes/arrays.php
msgid "SNMP Engine ID (v3)"
msgstr "SNMP Engine ID (v3)"

#: includes/arrays.php
msgid "Enter the SNMP v3 Engine Id or empty."
msgstr "Unesite SNMP v3 Engine Id ili ostavite prazno."

#: includes/arrays.php
msgid "SSH user"
msgstr "SSH korisnik"

#: includes/arrays.php
msgid "Insert username here"
msgstr "Ovdje unesite korisničko ime"

#: includes/arrays.php
msgid "SSH private key"
msgstr "SSH privatni ključ"

#: includes/arrays.php
msgid "SSH private key "
msgstr "SSH privatni ključ "

#: includes/arrays.php
msgid "SSH private key passphrase"
msgstr "Pristupna fraza za SSH privatni ključ"

#: includes/arrays.php
msgid "If your key is password protected, insert password here"
msgstr "Ako je vaš ključ zaštićen lozinkom, ovdje unesite lozinku"

#: includes/arrays.php
msgid "Client ID"
msgstr "ID klijenta"

#: includes/arrays.php
msgid "Oauth Client ID"
msgstr "Oauth klijentski ID"

#: includes/arrays.php
msgid "Client secret"
msgstr "Tajni ključ klijenta"

#: includes/arrays.php
msgid "OAuth Client secret"
msgstr "OAuth tajni ključ klijenta"

#: includes/arrays.php
msgid "Token name"
msgstr "Naziv tokena"

#: includes/arrays.php
msgid "Token value"
msgstr "Vrijednost tokena"

#: includes/arrays.php
msgid "<b>Can be used for a lot of service checks:</b><br/><i>Http/https</i> - optional, when it is set, try HTTP basic auth<br/><i>SMTP on port 587</i> - optional. Without a username/password, only the server response is tested. With a username and password, login is also performed<br/><i>Imap, imaps, pop3, pop3s, ftp</i> - optional. For anonymous ftp, use username \"anonymous\" and email address as password<br/><i>LDAP, smb, smbs</i> - required<br/><i>MQTT</i> - optional<br/><i>SCP, SSH command</i> - you can use this method or private key method"
msgstr "<b>Može se koristiti za mnoge provjere servisa:</b><br/><i>Http/https</i> - opciono, kada je postavljeno, pokušava se HTTP osnovna autentifikacija<br/><i>SMTP na portu 587</i> - opciono. Bez korisničkog imena/lozinke testira se samo odgovor servera. Sa korisničkim imenom i lozinkom vrši se i prijava<br/><i>Imap, imaps, pop3, pop3s, ftp</i> - opciono. Za anonimni ftp koristite korisničko ime \"anonymous\" i email adresu kao lozinku<br/><i>LDAP, smb, smbs</i> - obavezno<br/><i>MQTT</i> - opciono<br/><i>SCP, SSH naredba</i> - možete koristiti ovu metodu ili metodu privatnog ključa"

#: includes/arrays.php
msgid "Rest API - Basic HTTP auth. Username and password are required"
msgstr "Rest API - Osnovna HTTP autentifikacija. Korisničko ime i lozinka su obavezni"

#: includes/arrays.php
msgid "Rest API - API key auth<br/>Auth is sent in HTTP header, custom header or POST method. Credentials in URL are not supported.<br/>Insert API key name and value. Both values are required. For HTTP header the name <i>Bearer or apikey or \"\"</i> is usually used (Authorization: Bearer apivalue). For custom header <i>X-API-Key</i> is usually used (X-Api-Key: keyvalue). For POST <i>api_key</i> is usually used."
msgstr "Rest API - Autentifikacija API ključem<br/>Autentifikacija se šalje u HTTP zaglavlju, prilagođenom zaglavlju ili POST metodom. Akreditivi u URL-u nisu podržani.<br/>Unesite naziv i vrijednost API ključa. Obje vrijednosti su obavezne. Za HTTP zaglavlje obično se koristi naziv <i>Bearer ili apikey ili \"\"</i> (Authorization: Bearer apivalue). Za prilagođeno zaglavlje obično se koristi <i>X-API-Key</i> (X-Api-Key: keyvalue). Za POST se obično koristi <i>api_key</i>."

#: includes/arrays.php
msgid "Rest API - OAuth2/Bearer token auth<br/>You can have key/token from server and insert it here or use auth flow with credentials. Username and password are sent Json encoded."
msgstr "Rest API - OAuth2/Bearer token autentifikacija<br/>Možete imati ključ/token sa servera i unijeti ga ovdje ili koristiti tok autentifikacije sa akreditivima. Korisničko ime i lozinka se šalju kodirani u JSON formatu."

#: includes/arrays.php
msgid "Rest API - Cookie based auth - both values are required. After login, cookie is returned"
msgstr "Rest API - Autentifikacija zasnovana na kolačićima - obje vrijednosti su obavezne. Nakon prijave vraća se kolačić"

#: includes/arrays.php
msgid "SNMP v1 or v2 - required, insert community name here"
msgstr "SNMP v1 ili v2 - obavezno, ovdje unesite naziv zajednice"

#: includes/arrays.php
msgid "SNMP v3 - The security level determines which parameters are required"
msgstr "SNMP v3 - Nivo sigurnosti određuje koji su parametri obavezni"

#: includes/arrays.php
msgid "SSH private key - Can be used for SCP or SSH command test. These test can use username/password too"
msgstr "SSH privatni ključ - Može se koristiti za test SCP ili SSH naredbe. Ovi testovi mogu koristiti i korisničko ime/lozinku"

#: includes/arrays.php
msgid "It only checks whether the web server is responding. If username/password credential is used, it will try Basic HTTP auth."
msgstr "Provjerava samo da li web server odgovara. Ako se koriste akreditivi korisničko ime/lozinka, pokušat će osnovnu HTTP autentifikaciju."

#: includes/arrays.php
msgid "The same as HTTP plaintext but adds the ability to test certificates."
msgstr "Isto kao obični HTTP tekst, ali dodaje mogućnost testiranja certifikata."

#: includes/arrays.php
msgid "It only checks whether the SMTP server is responding. No authentication. You will see server login banner and ehlo response."
msgstr "Provjerava samo da li SMTP server odgovara. Bez autentifikacije. Vidjet ćete baner za prijavu servera i ehlo odgovor."

#: includes/arrays.php
msgid "Unencrypted + STARTTLS. It is also possible to test the validity of the certificate. Without username and password, you will see server login banner and ehlo response. With credential, login will be performed"
msgstr "Nekriptirano + STARTTLS. Također je moguće testirati validnost certifikata. Bez korisničkog imena i lozinke vidjet ćete baner za prijavu servera i ehlo odgovor. Sa akreditivima će se izvršiti prijava"

#: includes/arrays.php
msgid "Encrypted connection on default port 465. It is also possible to test the validity of the certificate. With username and password AUTH LOGIN will be tested."
msgstr "Kriptirana veza na podrazumijevanom portu 465. Također je moguće testirati validnost certifikata. Sa korisničkim imenom i lozinkom bit će testiran AUTH LOGIN."

#: includes/arrays.php
msgid "Unencrypted IMAP connection. Without credential, only connection will be tested. You will see only login banner. With credential login will be tested and try to read list of messages. You can use AUTHENTICATE PLAIN or AUTHENTICATE LOGIN method."
msgstr "Nekriptirana IMAP veza. Bez akreditiva će biti testirana samo veza. Vidjet ćete samo baner za prijavu. Sa akreditivima će biti testirana prijava i pokušat će se pročitati lista poruka. Možete koristiti metodu AUTHENTICATE PLAIN ili AUTHENTICATE LOGIN."

#: includes/arrays.php
msgid "The same as unencrypted IMAP but after login STARTTLS is used. It is also possible to test the validity of the certificate after STARTTLS."
msgstr "Isto kao nekriptirani IMAP, ali se nakon prijave koristi STARTTLS. Također je moguće testirati validnost certifikata nakon STARTTLS-a."

#: includes/arrays.php
msgid "Encrypted IMAP, you can try login and test certificate and user login"
msgstr "Kriptirani IMAP, možete pokušati prijavu i testirati certifikat i korisničku prijavu"

#: includes/arrays.php
msgid "Unencrypted POP3 connection. Without credential, only connection will be tested. You will see only login banner. With credential login will be tested and try to read list of messages"
msgstr "Nekriptirana POP3 veza. Bez akreditiva će biti testirana samo veza. Vidjet ćete samo baner za prijavu. Sa akreditivima će biti testirana prijava i pokušat će se pročitati lista poruka"

#: includes/arrays.php
msgid "The same as unencrypted POP3 but after login STARTTLS is used. It is also possible to test the validity of the certificate after STARTTLS."
msgstr "Isto kao nekriptirani POP3, ali se nakon prijave koristi STARTTLS. Također je moguće testirati validnost certifikata nakon STARTTLS-a."

#: includes/arrays.php
msgid "Encrypted POP3, you can try login and test certificate and user login."
msgstr "Kriptirani POP3, možete pokušati prijavu i testirati certifikat i korisničku prijavu."

#: includes/arrays.php
msgid "Try to resolve DNS record on specified DNS server"
msgstr "Pokušaj razriješiti DNS zapis na navedenom DNS serveru"

#: includes/arrays.php
msgid "Try DNS over HTTPS."
msgstr "Pokušaj DNS preko HTTPS-a."

#: includes/arrays.php
msgid "All parameters are required. Perform unencrypted LDAP login and search"
msgstr "Svi parametri su obavezni. Izvršava nekriptiranu LDAP prijavu i pretragu"

#: includes/arrays.php
msgid "All parameters are required. Perform encrypted LDAP login and search"
msgstr "Svi parametri su obavezni. Izvršava kriptiranu LDAP prijavu i pretragu"

#: includes/arrays.php
msgid "Unencrypted FTP connection, login and try to download file specified in path (/path/to/file.txt). For anonymous connection use login *anonymous* and email address as password. The content of the file is returned."
msgstr "Nekriptirana FTP veza, prijava i pokušaj preuzimanja datoteke navedene u putanji (/path/to/file.txt). Za anonimnu vezu koristite prijavu *anonymous* i email adresu kao lozinku. Vraća se sadržaj datoteke."

#: includes/arrays.php
msgid "Try to download file specified in path (/path/to/file.txt) from TFTP server. The content of the file is returned."
msgstr "Pokušaj preuzeti datoteku navedenu u putanji (/path/to/file.txt) sa TFTP servera. Vraća se sadržaj datoteke."

#: includes/arrays.php
msgid "Encrypted SCP connection, login and try to download file specified in path (/path/to/file.txt)."
msgstr "Šifrovana SCP veza, prijava i pokušaj preuzimanja datoteke navedene u putanji (/path/to/file.txt)."

#: includes/arrays.php
msgid "Try SMB protocol, username and password are required. Try to login and download file."
msgstr "Isprobaj SMB protokol, korisničko ime i lozinka su obavezni. Pokušaj se prijaviti i preuzeti datoteku."

#: includes/arrays.php
msgid "Connect to MQTT server and listen for any message. You can specify topic in Path (bedroom/temp), blank for any topic. For this test is recommended increase \"Long duration alert\""
msgstr "Poveži se na MQTT server i slušaj bilo koju poruku. Temu možeš navesti u Putanji (bedroom/temp), prazno za bilo koju temu. Za ovaj test se preporučuje povećati \"Upozorenje za dugo trajanje\""

#: includes/arrays.php
msgid "REST API test with basic HTTP auth. Prepare credential first."
msgstr "REST API test s osnovnom HTTP autentifikacijom. Prvo pripremi akreditive."

#: includes/arrays.php
msgid "REST API test with API key auth. Prepare credential first."
msgstr "REST API test s autentifikacijom putem API ključa. Prvo pripremi akreditive."

#: includes/arrays.php
msgid "REST API test with Oauth2. Prepare credential first."
msgstr "REST API test s Oauth2 autentifikacijom. Prvo pripremi akreditive."

#: includes/arrays.php
msgid "REST API test with cookie auth. Prepare credential first."
msgstr "REST API test s autentifikacijom putem kolačića. Prvo pripremi akreditive."

#: includes/arrays.php
msgid "Try SNMP get method. Output for specified OID is returned. Credential is required, you have to prepare SNMP v.1,2 or v3 credential first."
msgstr "Isprobaj SNMP get metodu. Vraća se izlaz za navedeni OID. Akreditiv je obavezan, prvo moraš pripremiti SNMP v.1,2 ili v3 akreditiv."

#: includes/arrays.php
msgid "Try SNMP walk method. Output for specified OID is returned. Credential is required, you have to prepare SNMP v.1,2 or v3 credential first."
msgstr "Isprobaj SNMP walk metodu. Vraća se izlaz za navedeni OID. Akreditiv je obavezan, prvo moraš pripremiti SNMP v.1,2 ili v3 akreditiv."

#: includes/arrays.php
msgid "Use ssh and connect to remote host. After login run specified command and return output. Username and password or private key is possible."
msgstr "Koristi ssh i poveži se na udaljeni host. Nakon prijave pokreni navedenu naredbu i vrati izlaz. Mogući su korisničko ime i lozinka ili privatni ključ."

#: includes/arrays.php
msgid "SFTP protocol on port 22, username and password and path are required. Try to do directory listing of path."
msgstr "SFTP protokol na portu 22, korisničko ime, lozinka i putanja su obavezni. Pokušaj prikazati sadržaj direktorija za putanju."

#: includes/arrays.php
msgid "All fine. Proceed as usual."
msgstr "Sve je u redu. Nastavi kao i obično."

#: includes/arrays.php
msgid "The URL you passed to libcurl used a protocol that this libcurl does not support. The support might be a compile-time option that you did not use, it can be a misspelled protocol string or just a protocol libcurl has no code for."
msgstr "URL proslijeđen biblioteci libcurl koristi protokol koji ovaj libcurl ne podržava. Podrška bi mogla biti opcija pri kompajliranju koja nije korištena, može biti pogrešno napisan niz protokola ili jednostavno protokol za koji libcurl nema kod."

#: includes/arrays.php
msgid "Early initialization code failed. This is likely to be an internal error or problem, or a resource problem where something fundamental could not get done at init time."
msgstr "Kod rane inicijalizacije nije uspio. Ovo je vjerovatno interna greška ili problem, ili problem s resursima gdje nešto osnovno nije moglo biti obavljeno tokom inicijalizacije."

#: includes/arrays.php
msgid "The URL was not properly formatted."
msgstr "URL nije pravilno formatiran."

#: includes/arrays.php
msgid "A requested feature, protocol or option was not found built-in in this libcurl due to a build-time decision. This means that a feature or option was not enabled or explicitly disabled when libcurl was built and in order to get it to function you have to get a rebuilt libcurl."
msgstr "Tražena funkcionalnost, protokol ili opcija nije pronađena ugrađena u ovaj libcurl zbog odluke prilikom izgradnje. To znači da funkcionalnost ili opcija nije bila omogućena ili je izričito onemogućena kada je libcurl izgrađen, te da bi radila moraš nabaviti ponovo izgrađen libcurl."

#: includes/arrays.php
msgid "Could not resolve proxy. The given proxy host could not be resolved."
msgstr "Nije moguće razriješiti proxy. Navedeni proxy host nije mogao biti razriješen."

#: includes/arrays.php
msgid "Could not resolve host. The given remote host was not resolved."
msgstr "Nije moguće razriješiti host. Navedeni udaljeni host nije razriješen."

#: includes/arrays.php
msgid "Failed to connect() to host or proxy."
msgstr "Povezivanje putem connect() na host ili proxy nije uspjelo."

#: includes/arrays.php
msgid "The server sent data libcurl could not parse. This error code was known as CURLE_FTP_WEIRD_SERVER_REPLY before 7.51.0."
msgstr "Server je poslao podatke koje libcurl nije mogao parsirati. Ovaj kod greške bio je poznat kao CURLE_FTP_WEIRD_SERVER_REPLY prije verzije 7.51.0."

#: includes/arrays.php
msgid "We were denied access to the resource given in the URL. For FTP, this occurs while trying to change to the remote directory."
msgstr "Odbijen nam je pristup resursu navedenom u URL-u. Za FTP se ovo dešava prilikom pokušaja prelaska u udaljeni direktorij."

#: includes/arrays.php
msgid "While waiting for the server to connect back when an active FTP session is used, an error code was sent over the control connection or similar."
msgstr "Dok se čekalo da se server ponovo poveže kada se koristi aktivna FTP sesija, poslan je kod greške preko kontrolne veze ili slično."

#: includes/arrays.php
msgid "After having sent the FTP password to the server, libcurl expects a proper reply. This error code indicates that an unexpected code was returned."
msgstr "Nakon slanja FTP lozinke serveru, libcurl očekuje odgovarajući odgovor. Ovaj kod greške ukazuje na to da je vraćen neočekivani kod."

#: includes/arrays.php
msgid "During an active FTP session while waiting for the server to connect, the CURLOPT_ACCEPTTIMEOUT_MS (or the internal default) timeout expired."
msgstr "Tokom aktivne FTP sesije, dok se čekalo da se server poveže, isteklo je vremensko ograničenje CURLOPT_ACCEPTTIMEOUT_MS (ili interno podrazumijevano)."

#: includes/arrays.php
msgid "Libcurl failed to get a sensible result back from the server as a response to either a PASV or a EPSV command. The server is flawed."
msgstr "Libcurl nije uspio dobiti smislen rezultat nazad sa servera kao odgovor na PASV ili EPSV naredbu. Server je neispravan."

#: includes/arrays.php
msgid "FTP servers return a 227-line as a response to a PASV command. If libcurl fails to parse that line, this return code is passed back."
msgstr "FTP serveri vraćaju 227-liniju kao odgovor na PASV naredbu. Ako libcurl ne uspije parsirati tu liniju, vraća se ovaj povratni kod."

#: includes/arrays.php
msgid "An internal failure to lookup the host used for the new connection."
msgstr "Interna greška pri traženju hosta koji se koristi za novu vezu."

#: includes/arrays.php
msgid "A problem was detected in the HTTP2 framing layer. This is somewhat generic and can be one out of several problems, see the error buffer for details."
msgstr "Otkriven je problem u sloju uokvirivanja HTTP2. Ovo je donekle općenito i može biti jedan od nekoliko problema, pogledaj bafer grešaka za detalje."

#: includes/arrays.php
msgid "Received an error when trying to set the transfer mode to binary or ASCII."
msgstr "Primljena je greška prilikom pokušaja postavljanja načina prijenosa na binarni ili ASCII."

#: includes/arrays.php
msgid "A file transfer was shorter or larger than expected. This happens when the server first reports an expected transfer size, and then delivers data that does not match the previously given size."
msgstr "Prijenos datoteke bio je kraći ili veći od očekivanog. Ovo se dešava kada server prvo prijavi očekivanu veličinu prijenosa, a zatim isporuči podatke koji ne odgovaraju prethodno navedenoj veličini."

#: includes/arrays.php
msgid "This was either a weird reply to a 'RETR' command or a zero byte transfer complete."
msgstr "Ovo je bio ili čudan odgovor na naredbu 'RETR' ili završen prijenos od nula bajtova."

#: includes/arrays.php
msgid "Obsolete Error"
msgstr "Zastarjela greška"

#: includes/arrays.php
msgid "Not used in modern versions."
msgstr "Ne koristi se u modernim verzijama."

#: includes/arrays.php
msgid "When sending custom \"QUOTE\" commands to the remote server, one of the commands returned an error code that was 400 or higher (for FTP) or otherwise indicated unsuccessful completion of the command."
msgstr "Prilikom slanja prilagođenih \"QUOTE\" naredbi udaljenom serveru, jedna od naredbi vratila je kod greške 400 ili viši (za FTP) ili je na drugi način ukazala na neuspješno izvršenje naredbe."

#: includes/arrays.php
msgid "This is returned if CURLOPT_FAILONERROR is set true and the HTTP server returns an error code that is >= 400."
msgstr "Ovo se vraća ako je CURLOPT_FAILONERROR postavljeno na true i HTTP server vrati kod greške koji je >= 400."

#: includes/arrays.php
msgid "An error occurred when writing received data to a local file, or an error was returned to libcurl from a write callback."
msgstr "Došlo je do greške prilikom pisanja primljenih podataka u lokalnu datoteku, ili je biblioteci libcurl vraćena greška iz povratnog poziva za pisanje."

#: includes/arrays.php
msgid "Failed starting the upload. For FTP, the server typically denied the STOR command. The error buffer usually contains the server's explanation for this."
msgstr "Pokretanje otpremanja nije uspjelo. Za FTP, server je obično odbio STOR naredbu. Bafer grešaka obično sadrži objašnjenje servera za ovo."

#: includes/arrays.php
msgid "There was a problem reading a local file or an error returned by the read callback."
msgstr "Došlo je do problema pri čitanju lokalne datoteke ili je vraćena greška iz povratnog poziva za čitanje."

#: includes/arrays.php
msgid "A memory allocation request failed. This is serious badness and things are severely screwed up if this ever occurs."
msgstr "Zahtjev za alokaciju memorije nije uspio. Ovo je ozbiljan problem i stvari su ozbiljno poremećene ako se ovo ikada dogodi."

#: includes/arrays.php
msgid "Operation timeout. The specified time-out period was reached according to the conditions."
msgstr "Istek vremena operacije. Navedeni period čekanja je dostignut u skladu sa uslovima."

#: includes/arrays.php
msgid "The FTP PORT command returned error. This mostly happens when you have not specified a good enough address for libcurl to use. See CURLOPT_FTPPORT."
msgstr "FTP PORT komanda je vratila grešku. Ovo se najčešće dešava kada niste naveli dovoljno dobru adresu koju bi libcurl koristio. Pogledajte CURLOPT_FTPPORT."

#: includes/arrays.php
msgid "The FTP REST command returned error. This should never happen if the server is sane."
msgstr "FTP REST komanda je vratila grešku. Ovo se nikada ne bi trebalo desiti ako je server ispravan."

#: includes/arrays.php
msgid "The server does not support or accept range requests."
msgstr "Server ne podržava ili ne prihvata zahtjeve za opseg."

#: includes/arrays.php
msgid "This is an odd error that mainly occurs due to internal confusion."
msgstr "Ovo je neobična greška koja se uglavnom javlja zbog interne zabune."

#: includes/arrays.php
msgid "A problem occurred somewhere in the SSL/TLS handshake. You really want the error buffer and read the message there as it pinpoints the problem slightly more. Could be certificates (file formats, paths, permissions), passwords, and others."
msgstr "Došlo je do problema negdje tokom SSL/TLS rukovanja. Zaista vam je potreban bafer grešaka da pročitate poruku u njemu jer ona nešto preciznije ukazuje na problem. Mogu biti certifikati (formati datoteka, putanje, dozvole), lozinke i drugo."

#: includes/arrays.php
msgid "The download could not be resumed because the specified offset was out of the file boundary."
msgstr "Preuzimanje nije moglo biti nastavljeno jer je navedeni pomak bio izvan granica datoteke."

#: includes/arrays.php
msgid "A file given with FILE:// could not be opened. Most likely because the file path does not identify an existing file. Did you check file permissions?"
msgstr "Datoteka navedena sa FILE:// nije mogla biti otvorena. Najvjerovatnije zato što putanja datoteke ne označava postojeću datoteku. Da li ste provjerili dozvole datoteke?"

#: includes/arrays.php
msgid "LDAP cannot bind. LDAP bind operation failed."
msgstr "LDAP se ne može povezati. LDAP operacija povezivanja nije uspjela."

#: includes/arrays.php
msgid "LDAP search failed."
msgstr "LDAP pretraga nije uspjela."

#: includes/arrays.php
msgid "Function not found. A required zlib function was not found."
msgstr "Funkcija nije pronađena. Potrebna zlib funkcija nije pronađena."

#: includes/arrays.php
msgid "Aborted by callback. A callback returned \"abort\" to libcurl."
msgstr "Prekinuto od strane povratnog poziva. Povratni poziv je vratio \"abort\" za libcurl."

#: includes/arrays.php
msgid "A function was called with a bad parameter."
msgstr "Funkcija je pozvana sa neispravnim parametrom."

#: includes/arrays.php
msgid "Interface error. A specified outgoing interface could not be used. Set which interface to use for outgoing connections' source IP address with URLOPT_INTERFACE."
msgstr "Greška interfejsa. Navedeni odlazni interfejs nije mogao biti korišten. Postavite koji interfejs koristiti za izvornu IP adresu odlaznih konekcija pomoću URLOPT_INTERFACE."

#: includes/arrays.php
msgid "Too many redirects. When following redirects, libcurl hit the maximum amount. Set your limit with CURLOPT_MAXREDIRS."
msgstr "Previše preusmjeravanja. Prilikom praćenja preusmjeravanja, libcurl je dostigao maksimalan broj. Postavite svoje ograničenje pomoću CURLOPT_MAXREDIRS."

#: includes/arrays.php
msgid "An option passed to libcurl is not recognized/known. Refer to the appropriate documentation. This is most likely a problem in the program that uses libcurl. The error buffer might contain more specific information about which exact option it concerns."
msgstr "Opcija proslijeđena za libcurl nije prepoznata/poznata. Pogledajte odgovarajuću dokumentaciju. Ovo je najvjerovatnije problem u programu koji koristi libcurl. Bafer grešaka može sadržavati preciznije informacije o tome na koju se tačno opciju odnosi."

#: includes/arrays.php
msgid "An option passed in to a setopt was wrongly formatted. See error message for details about what option."
msgstr "Opcija proslijeđena u setopt je pogrešno formatirana. Pogledajte poruku o grešci za detalje o kojoj se opciji radi."

#: includes/arrays.php
msgid "Nothing was returned from the server, and under the circumstances, getting nothing is considered an error."
msgstr "Ništa nije vraćeno sa servera, a pod datim okolnostima, nedobijanje ničega se smatra greškom."

#: includes/arrays.php
msgid "The specified crypto engine was not found."
msgstr "Navedeni kriptografski mehanizam nije pronađen."

#: includes/arrays.php
msgid "Failed setting the selected SSL crypto engine as default."
msgstr "Neuspješno postavljanje odabranog SSL kriptografskog mehanizma kao podrazumijevanog."

#: includes/arrays.php
msgid "Failed sending network data."
msgstr "Neuspješno slanje mrežnih podataka."

#: includes/arrays.php
msgid "Failure with receiving network data."
msgstr "Greška pri primanju mrežnih podataka."

#: includes/arrays.php
msgid "problem with the local client certificate."
msgstr "problem sa lokalnim klijentskim certifikatom."

#: includes/arrays.php
msgid "Could not use specified cipher."
msgstr "Nije moguće koristiti navedenu šifru."

#: includes/arrays.php
msgid "The remote server's SSL certificate or SSH fingerprint was deemed not OK. This error code has been unified with CURLE_SSL_CACERT since 7.62.0. Its previous value was 51."
msgstr "SSL certifikat udaljenog servera ili SSH otisak prsta je ocijenjen kao neispravan. Ovaj kod greške je objedinjen sa CURLE_SSL_CACERT od verzije 7.62.0. Njegova prethodna vrijednost je bila 51."

#: includes/arrays.php
msgid "Unrecognized transfer encoding."
msgstr "Nepoznato kodiranje prijenosa."

#: includes/arrays.php
msgid "Maximum file size exceeded."
msgstr "Prekoračena maksimalna veličina datoteke."

#: includes/arrays.php
msgid "Requested FTP SSL level failed."
msgstr "Traženi FTP SSL nivo nije uspio."

#: includes/arrays.php
msgid "When doing a send operation curl had to rewind the data to retransmit, but the rewinding operation failed."
msgstr "Prilikom izvršavanja operacije slanja, curl je morao premotati podatke za ponovni prijenos, ali operacija premotavanja nije uspjela."

#: includes/arrays.php
msgid "Initiating the SSL Engine failed."
msgstr "Pokretanje SSL mehanizma nije uspjelo."

#: includes/arrays.php
msgid "The remote server denied curl to login (Added in 7.13.1)"
msgstr "Udaljeni server je odbio prijavu za curl (Dodano u 7.13.1)"

#: includes/arrays.php
msgid "File not found on TFTP server."
msgstr "Datoteka nije pronađena na TFTP serveru."

#: includes/arrays.php
msgid "Permission problem on TFTP server."
msgstr "Problem sa dozvolama na TFTP serveru."

#: includes/arrays.php
msgid "Out of disk space on the server."
msgstr "Nema više prostora na disku na serveru."

#: includes/arrays.php
msgid "Illegal TFTP operation."
msgstr "Nedozvoljena TFTP operacija."

#: includes/arrays.php
msgid "Unknown TFTP transfer ID."
msgstr "Nepoznat ID TFTP prijenosa."

#: includes/arrays.php
msgid "File already exists and is not overwritten."
msgstr "Datoteka već postoji i nije prepisana."

#: includes/arrays.php
msgid "This error should never be returned by a properly functioning TFTP server."
msgstr "Ovu grešku nikada ne bi trebao vratiti TFTP server koji ispravno funkcioniše."

#: includes/arrays.php
msgid "Problem with reading the SSL CA cert (path? access rights?)"
msgstr "Problem sa čitanjem SSL CA certifikata (putanja? prava pristupa?)"

#: includes/arrays.php
msgid "The resource referenced in the URL does not exist."
msgstr "Resurs naveden u URL-u ne postoji."

#: includes/arrays.php
msgid "An unspecified error occurred during the SSH session."
msgstr "Došlo je do nespecificirane greške tokom SSH sesije."

#: includes/arrays.php
msgid "Failed to shut down the SSL connection."
msgstr "Neuspješno zatvaranje SSL konekcije."

#: includes/arrays.php
msgid "Socket is not ready for send/recv wait till it's ready and try again. This return code is only returned from curl_easy_recv and curl_easy_send (Added in 7.18.2)"
msgstr "Socket nije spreman za slanje/primanje, sačekajte dok ne bude spreman i pokušajte ponovo. Ovaj povratni kod se vraća samo iz curl_easy_recv i curl_easy_send (Dodano u 7.18.2)"

#: includes/arrays.php
msgid "Failed to load CRL file (Added in 7.19.0)"
msgstr "Neuspješno učitavanje CRL datoteke (Dodano u 7.19.0)"

#: includes/arrays.php
msgid "Issuer check failed (Added in 7.19.0)"
msgstr "Provjera izdavača nije uspjela (Dodano u 7.19.0)"

#: includes/arrays.php
msgid "The FTP server does not understand the PRET command at all or does not support the given argument. Be careful when using CURLOPT_CUSTOMREQUEST, a custom LIST command is sent with the PRET command before PASV as well. (Added in 7.20.0)"
msgstr "FTP server uopšte ne razumije PRET komandu ili ne podržava dati argument. Budite oprezni kada koristite CURLOPT_CUSTOMREQUEST, prilagođena LIST komanda se također šalje sa PRET komandom prije PASV. (Dodano u 7.20.0)"

#: includes/arrays.php
msgid "Mismatch of RTSP CSeq numbers."
msgstr "Nepodudaranje RTSP CSeq brojeva."

#: includes/arrays.php
msgid "Mismatch of RTSP Session Identifiers."
msgstr "Nepodudaranje identifikatora RTSP sesije."

#: includes/arrays.php
msgid "Unable to parse FTP file list (during FTP wildcard downloading)."
msgstr "Nije moguće raščlaniti FTP listu datoteka (tokom FTP preuzimanja sa džoker znakovima)."

#: includes/arrays.php
msgid "Chunk callback reported error."
msgstr "Povratni poziv za dio (chunk) je prijavio grešku."

#: includes/arrays.php
msgid "(For internal use only, is never returned by libcurl) No connection available, the session is queued. (added in 7.30.0)"
msgstr "(Samo za internu upotrebu, libcurl ga nikada ne vraća) Nema dostupne konekcije, sesija je stavljena u red čekanja. (dodano u 7.30.0)"

#: includes/arrays.php
msgid "Failed to match the pinned key specified with CURLOPT_PINNEDPUBLICKEY."
msgstr "Neuspješno podudaranje prikačenog ključa navedenog pomoću CURLOPT_PINNEDPUBLICKEY."

#: includes/arrays.php
msgid "Status returned failure when asked with CURLOPT_SSL_VERIFYSTATUS."
msgstr "Status je vratio grešku kada je zatražen pomoću CURLOPT_SSL_VERIFYSTATUS."

#: includes/arrays.php
msgid "Stream error in the HTTP/2 framing layer."
msgstr "Greška toka u HTTP/2 sloju uokvirivanja."

#: includes/arrays.php
msgid "An API function was called from inside a callback."
msgstr "API funkcija je pozvana iz unutrašnjosti povratnog poziva."

#: includes/arrays.php
msgid "An authentication function returned an error."
msgstr "Funkcija za autentifikaciju je vratila grešku."

#: includes/arrays.php
msgid "A problem was detected in the HTTP/3 layer. This is somewhat generic and can be one out of several problems, see the error buffer for details."
msgstr "Otkriven je problem u HTTP/3 sloju. Ovo je donekle općenito i može biti jedan od nekoliko problema, pogledajte bafer grešaka za detalje."

#: includes/arrays.php
msgid "QUIC connection error. This error may be caused by an SSL library error. QUIC is the protocol used for HTTP/3 transfers."
msgstr "Greška QUIC konekcije. Ovu grešku može uzrokovati greška SSL biblioteke. QUIC je protokol koji se koristi za HTTP/3 prijenose."

#: includes/arrays.php
msgid "Proxy handshake error. CURLINFO_PROXY_ERROR provides extra details on the specific problem."
msgstr "Greška pri proxy rukovanju. CURLINFO_PROXY_ERROR pruža dodatne detalje o konkretnom problemu."

#: includes/arrays.php
msgid "SSL Client Certificate required."
msgstr "Potreban je SSL klijentski certifikat."

#: includes/arrays.php
msgid "An internal call to poll() or select() returned error that is not recoverable."
msgstr "Interni poziv ka poll() ili select() vratio je nepopravljivu grešku."

