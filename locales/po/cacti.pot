#: includes/arrays.php:862
msgid ""
"<b>Can be used for a lot of service checks:</b><br/>\\\n"
"\t\t<i>Http/https</i> - optional, when it is set, try HTTP basic auth<br/>\\\n"
"\t\t<i>SMTP on port 587 - optional. Without a username/password, only the server response is tested. With a username and password, login is also performed<br/>\\\n"
"\t\t<i>Imap, imaps, pop3, pop3s, ftp</i> - optional. For anonymous ftp, use username \\\"anonymous\\\" and email address as password<br/>\\\n"
"\t\t<i>LDAP, smb, smbs</i> - required<br/>\\\n"
"\t\t<i>MQTT</i> - optional<br/>\\\n"
"\t\t<i>SCP, SSH command</i> - you can use this method or private key method"
msgstr ""

#: includes/arrays.php:869
msgid "Rest API - Basic HTTP auth. Username and password are required"
msgstr ""

#: includes/arrays.php:870
msgid ""
"Rest API - API key auth<br/>Auth is send in HTTP header, custom header or POST method. Credentials in URL is not supported.<br/>Insert API key name and value. Both values are required.\\\n"
"\t\tFor HTTP header the name <i>Bearer or apikey or \\\"\\\"</i> is usually used (Authorization: Bearer apivalue).\\\n"
"\t\tFor custom header <i>X-API-Key</i> is usually used (X-Api-Key: keyvalue).\\\n"
"\t\tFor POST <i>api_key</i> is usually used."
msgstr ""

#: includes/arrays.php:874
msgid "Rest API - OAuth2/Bearer token auth<br/>You can have key/token from server and insert it here or use auth flow with credentials. Username and password are send Json encoded."
msgstr ""

#: includes/arrays.php:875
msgid "Rest API - Cookie based auth - both values are required. After login, cookie is returned"
msgstr ""

#: includes/arrays.php:876
msgid "SNMP v1 or v2 - required, insert community name here"
msgstr ""

#: includes/arrays.php:877
msgid "SNMP v3 - The security level determines which parameters are required"
msgstr ""

#: includes/arrays.php:878
msgid "SSH private key - Can be used for SCP or SSH command test. These test can use username/password too"
msgstr ""

#: includes/arrays.php:882
