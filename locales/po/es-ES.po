#: includes/arrays.php
msgid ""
"<b>Can be used for a lot of service checks:</b><br/>\\\n"
"\t\t<i>Http/https</i> - optional, when it is set, try HTTP basic auth<br/>\\\n"
"\t\t<i>SMTP on port 587 - optional. Without a username/password, only the server response is tested. With a username and password, login is also performed<br/>\\\n"
"\t\t<i>Imap, imaps, pop3, pop3s, ftp</i> - optional. For anonymous ftp, use username \\\"anonymous\\\" and email address as password<br/>\\\n"
"\t\t<i>LDAP, smb, smbs</i> - required<br/>\\\n"
"\t\t<i>MQTT</i> - optional<br/>\\\n"
"\t\t<i>SCP, SSH command</i> - you can use this method or private key method"
msgstr ""

