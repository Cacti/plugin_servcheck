msgstr "Kpochapụ Ihe nzacha"

#: servcheck_credential.php servcheck_test.php
msgid "Duplicate"
msgstr "Oyiri"

#: servcheck_credential.php
msgid "Click 'Continue' to Duplicate the following Credential."
msgid_plural "Click 'Continue' to Duplicate the following Credentials."
msgstr[0] "Pịa 'Gaa n'ihu' iji Mepụta oyiri Nzere ndị na-esonụ."

