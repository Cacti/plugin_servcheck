msgid "Login URL"
msgstr "URL за пријаву"

#: includes/arrays.php
msgid "URL which is used to log in or get the token."
msgstr "URL који се користи за пријаву или преузимање токена."

#: includes/arrays.php
msgid "Data URL"
msgstr "URL за податке"

#: includes/arrays.php
msgid "URL to retrieve data. Insert with http:// or https://"
msgstr "URL за преузимање података. Унесите са http:// или https://"

#: includes/arrays.php
msgid "SNMP v1 or v2 community"
msgstr "SNMP v1 или v2 заједница"

#: includes/arrays.php
