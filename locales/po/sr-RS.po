msgstr "SSH приватни кључ "

#: includes/arrays.php
msgid "SSH private key passphrase"
msgstr "Приступна фраза за SSH приватни кључ"

#: includes/arrays.php
msgid "If your key is password protected, insert password here"
msgstr "Ако је ваш кључ заштићен лозинком, овде унесите лозинку"

#: includes/arrays.php
msgid "Client ID"
msgstr "ID клијента"

#: includes/arrays.php
msgid "Oauth Client ID"
msgstr "OAuth ID клијента"

#: includes/arrays.php
msgid "Client secret"
msgstr "Тајна клијента"

#: includes/arrays.php
