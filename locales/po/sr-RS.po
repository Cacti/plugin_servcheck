msgstr "SNMP ниска заједнице за SNMP v1 или v2(c)"

#: includes/arrays.php
msgid "SNMP Security Level"
msgstr "SNMP ниво безбедности"

#: includes/arrays.php
msgid "SNMP v3 Security Level to use when querying the device."
msgstr "SNMP v3 ниво безбедности који се користи при упиту уређаја."

#: includes/arrays.php
msgid "SNMP Auth Protocol (v3)"
msgstr "SNMP протокол аутентификације (v3)"

#: includes/arrays.php
msgid "Choose the SNMPv3 Authorization Protocol."
msgstr "Изаберите SNMPv3 протокол ауторизације."

#: includes/arrays.php
msgid "SNMP Username (v3)"
msgstr "SNMP корисничко име (v3)"

#: includes/arrays.php
msgid "SNMP v3 username for this device."
msgstr "SNMP v3 корисничко име за овај уређај."

#: includes/arrays.php
msgid "SNMP Password (v3)"
