#: includes/arrays.php
msgid "SNMP Privacy Protocol (v3)"
msgstr "SNMP протокол приватности (v3)"

#: includes/arrays.php
msgid "Choose the SNMPv3 Privacy Protocol."
msgstr "Изаберите SNMPv3 протокол приватности."

#: includes/arrays.php
msgid "SNMP Privacy Passphrase (v3)"
msgstr "SNMP приступна фраза приватности (v3)"

#: includes/arrays.php
msgid "Choose the SNMPv3 Privacy Passphrase."
msgstr "Изаберите SNMPv3 приступну фразу приватности."

#: includes/arrays.php
msgid "SNMP Context (v3)"
msgstr "SNMP контекст (v3)"

#: includes/arrays.php
msgid "Enter the SNMP Context to use for this device."
msgstr "Унесите SNMP контекст који ће се користити за овај уређај."

#: includes/arrays.php
msgid "SNMP Engine ID (v3)"
msgstr "SNMP ID механизма (v3)"

#: includes/arrays.php
msgid "Enter the SNMP v3 Engine Id or empty."
msgstr "Унесите SNMP v3 Engine ID или оставите празно."

#: includes/arrays.php
msgid "SSH user"
msgstr "SSH корисник"

#: includes/arrays.php
msgid "Insert username here"
msgstr "Овде унесите корисничко име"

#: includes/arrays.php
msgid "SSH private key"
msgstr "SSH приватни кључ"

#: includes/arrays.php
