msgstr "Token-/API-nyckelnamn"

#: includes/arrays.php
msgid "Too many redirects. When following redirects, libcurl hit the maximum amount. Set your limit with CURLOPT_MAXREDIRS."
msgstr "För många omdirigeringar. När du följer omdirigeringar når libcurl det maximala beloppet. Sätt din gräns med CURLOPT_MAXREDIRS."

#: includes/arrays.php
msgid "Trigger"
msgstr "Utlösare"

#: includes/arrays.php
msgid "Try DNS over HTTPS."
msgstr "Prova DNS över HTTPS."

#: includes/arrays.php
msgid "Try SMB protocol, username and password are required. Try to login and download file."
msgstr ""
"Prova SMB-protokollet; användarnamn och lösenord krävs. Försök logga in och "
"hämta fil."

#: includes/arrays.php
msgid "Try SNMP get method. Output for specified OID is returned. Credential is required, you have to prepare SNMP v.1,2 or v3 credential first."
msgstr ""
"Prova SNMP-hämtningsmetoden. Utdata för angivet OID returneras. "
"Inloggningsuppgift krävs; förbered först en SNMP v1-, v2- eller "
"v3-inloggningsuppgift."

#: includes/arrays.php
msgid "Try SNMP walk method. Output for specified OID is returned. Credential is required, you have to prepare SNMP v.1,2 or v3 credential first."
msgstr ""
"Prova SNMP-genomgångsmetoden. Utdata för angivet OID returneras. "
"Inloggningsuppgift krävs; förbered först en SNMP v1-, v2- eller "
"v3-inloggningsuppgift."

#: includes/arrays.php
msgid "Try to download file specified in path (/path/to/file.txt) from TFTP server. The content of the file is returned."
msgstr ""
"Försök hämta filen som anges i sökvägen (/sökväg/till/fil.txt) från TFTP-"
"servern. Filens innehåll returneras."

#: includes/arrays.php
msgid "Try to resolve DNS record on specified DNS server"
msgstr "Försök slå upp DNS-post på angiven DNS-server"

