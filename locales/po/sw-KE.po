msgstr "Kirai cha siri cha ufunguo wa faragha wa SSH"

#: includes/arrays.php
msgid "If your key is password protected, insert password here"
msgstr "Ikiwa ufunguo wako umelindwa kwa nenosiri, weka nenosiri hapa"

#: includes/arrays.php
msgid "Client ID"
msgstr "Kitambulisho cha Mteja"

#: includes/arrays.php
