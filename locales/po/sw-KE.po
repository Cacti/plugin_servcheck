msgstr "Chagua Itifaki ya Faragha ya SNMPv3."

#: includes/arrays.php
msgid "SNMP Privacy Passphrase (v3)"
msgstr "Kifungu cha Siri cha Faragha cha SNMP (v3)"

#: includes/arrays.php
msgid "Choose the SNMPv3 Privacy Passphrase."
msgstr "Chagua Kifungu cha Siri cha Faragha cha SNMPv3."

#: includes/arrays.php
msgid "SNMP Context (v3)"
msgstr "Muktadha wa SNMP (v3)"

#: includes/arrays.php
msgid "Enter the SNMP Context to use for this device."
msgstr "Ingiza Muktadha wa SNMP wa kutumia kwa kifaa hiki."

#: includes/arrays.php
msgid "SNMP Engine ID (v3)"
msgstr "Kitambulisho cha Injini ya SNMP (v3)"

#: includes/arrays.php
msgid "Enter the SNMP v3 Engine Id or empty."
msgstr "Ingiza Kitambulisho cha Injini ya SNMP v3 au acha wazi."

#: includes/arrays.php
